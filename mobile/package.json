{
  "name": "saferideapp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write App.tsx src tests",
    "prepare:vision": "node scripts/prepare-vision.mjs",
    "prebuild": "npm run prepare:vision",
    "preweb": "npm run prepare:vision"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
